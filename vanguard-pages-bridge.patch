diff --git a/public/grima-import.js b/public/grima-import.js
new file mode 100644
index 0000000..842d98e
--- /dev/null
+++ b/public/grima-import.js
@@ -0,0 +1,33 @@
+// Grima snapshots are carried in the fragment, not sent to the Pages host.
+async function decodeGrimaSnapshot(token){
+ if(!/^[A-Za-z0-9_-]+$/.test(token)||token.length>20000)throw Error('Invalid Grima link.');
+ let base=token.replace(/-/g,'+').replace(/_/g,'/');base+='='.repeat((4-base.length%4)%4);
+ let bytes=Uint8Array.from(atob(base),c=>c.charCodeAt(0));
+ let reader=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('deflate')).getReader();
+ let chunks=[],length=0;
+ try{while(true){let {done,value}=await reader.read();if(done)break;length+=value.length;if(length>2000000)throw Error('Grima snapshot is too large.');chunks.push(value)}}finally{await reader.cancel()}
+ let all=new Uint8Array(length),offset=0;for(let chunk of chunks){all.set(chunk,offset);offset+=chunk.length}
+ let data=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(all));validateSession(data);return data;
+}
+async function receiveGrimaSnapshot(){
+ if(!location.hash.startsWith('#grima='))return;
+ let token=location.hash.slice(7);
+ history.replaceState(null,'',location.pathname+location.search);
+ let dialog=document.createElement('dialog');
+ let title=document.createElement('h2');title.textContent='Grima signup snapshot';dialog.append(title);
+ let status=document.createElement('p');status.textContent='Reading signups…';status.setAttribute('role','status');dialog.append(status);
+ let close=document.createElement('button');close.textContent='Cancel';close.onclick=()=>dialog.close();dialog.append(close);
+ dialog.addEventListener('close',()=>dialog.remove());document.body.append(dialog);dialog.showModal();
+ try{
+  let data=await decodeGrimaSnapshot(token);if(!dialog.isConnected)return;
+  status.textContent=`${data.players.length} signups. Loading replaces the open plan. Export your current plan first if you want to keep it.`;
+  let copy=document.createElement('button');copy.textContent='Copy JSON';
+  copy.onclick=async()=>{try{await navigator.clipboard.writeText(JSON.stringify(data));status.textContent='JSON copied to clipboard.'}catch(e){status.textContent='Clipboard access was denied. Use Download JSON instead.'}};
+  let download=document.createElement('button');download.textContent='Download JSON';
+  download.onclick=()=>{let url=URL.createObjectURL(new Blob([JSON.stringify(data)],{type:'application/json'}));let a=document.createElement('a');a.href=url;a.download='grima-signups.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
+  let load=document.createElement('button');load.textContent='Load signups';load.className='primary';
+  load.onclick=()=>{try{restoreSession(data);dialog.close()}catch(e){status.textContent='Could not load this session: '+e.message}};
+  dialog.insertBefore(copy,close);dialog.insertBefore(download,close);dialog.insertBefore(load,close);
+ }catch(e){status.textContent='Could not read this Grima link. Export the JSON from Grima and import the file instead.'}
+}
+if(typeof window!=='undefined')receiveGrimaSnapshot();
