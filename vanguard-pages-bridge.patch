 async function copyDiscordMessage(i){try{await navigator.clipboard.writeText(discordMessages[i].text);toast('Discord message copied')}catch(e){let field=document.getElementById('discordmessage'+i);field.focus();field.select();toast('Select and copy the highlighted message')}}
 
 function sessionSnapshot(){return {format:'vanguard-raid-planner-session',version:6,fellowshipSetup,rolePriorities,constraints,templateLibrary:{constraints:constraintTemplates,comps:compTemplates,roles:roleTemplates},templateName:activeTemplateName,exportedAt:new Date().toISOString(),players,runs,template,settings:{size,duration,fair,suggestSchedule,lockPriority,recommendationRunLimit:Math.max(recommendationRunLimit||0,runSlots().length),configuredRuns:scheduleOverrideBase?JSON.parse(JSON.stringify(scheduleOverrideBase)):undefined},teams,recommendations,hasGenerated,dirty,message,discordEmojis,notes:{healCut:localStorage.getItem('healnotes')||'',defensiveCDs:localStorage.getItem('cdnotes')||''},savedTemplate:localStorage.getItem('vanguard-template')||null}}
-function compactSessionSnapshot(){ensureRosterCharacters();players.forEach(migratePlayerExperience);let snapshot=sessionSnapshot();snapshot.players=snapshot.players.map(p=>{let copy={...p};delete copy.isNewPlayer;if(!copy.experiencedClasses?.length)delete copy.experiencedClasses;if(!copy.inexperiencedClasses?.length)delete copy.inexperiencedClasses;if(!copy.raidLeader)delete copy.raidLeader;else copy.raidLeader=true;migratePrimary(copy);if(!copy.primary)delete copy.primary;return copy});return {...snapshot,version:7,teams:snapshot.teams.map(t=>{let {fellowships,constraintResults,...raid}=t;return {...raid,members:t.members.map(p=>({id:p.id,name:p.name,c:p.c,spec:p.spec,role:p.role,rank:p.rank,charId:p.charId,repeated:p.repeated}))}})}}
+function compactSessionSnapshot(){ensureRosterCharacters();players.forEach(migratePlayerExperience);let snapshot=sessionSnapshot();snapshot.players=snapshot.players.map(p=>{let copy={...p};delete copy.isNewPlayer;if(!copy.experiencedClasses?.length)delete copy.experiencedClasses;if(!copy.inexperiencedClasses?.length)delete copy.inexperiencedClasses;if(!copy.raidLeader)delete copy.raidLeader;else copy.raidLeader=true;migratePrimary(copy);if(!copy.primary)delete copy.primary;return copy});return {...snapshot,version:7,teams:snapshot.teams.map(t=>{let {fellowships,constraintResults,...raid}=t;return {...raid,grimaFellowships:(t.fellowships?.length?t.fellowships:assignFellowships(t.members)).map(group=>group.map(p=>p.id)),members:t.members.map(p=>({id:p.id,name:p.name,c:p.c,spec:p.spec,role:p.role,rank:p.rank,charId:p.charId,repeated:p.repeated}))}})}}
 function migrateSessionClassRoles(data){if(!data||typeof data!=='object')return data;let copy=JSON.parse(JSON.stringify(data));let update=p=>{if(p?.c==='Lore-master'&&p.spec==='Blue'&&p.role==='Debuffer')p.role='Buffer'};for(let p of copy.players||[]){for(let c of p.choices||[])update(c);for(let cs of Object.values(p.eventChoices||{}))if(Array.isArray(cs))cs.forEach(update)}for(let t of copy.teams||[]){for(let p of t.members||[])update(p);for(let g of t.fellowships||[])if(Array.isArray(g))g.forEach(update)}return copy}
 function expandCompactSession(data){data=migrateSessionClassRoles(data);if(data?.version!==7)return data;if(!Array.isArray(data.players)||!Array.isArray(data.teams))throw Error('Invalid compact session.');let roster=new Map(data.players.map(p=>[p.id,p]));return {...data,version:6,teams:data.teams.map(t=>({...t,members:Array.isArray(t.members)?t.members.map(p=>({...roster.get(p.id),...p})):t.members}))}}
